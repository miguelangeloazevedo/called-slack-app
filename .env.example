# Slack app credentials (api.slack.com/apps -> Called -> Basic Information / OAuth & Permissions / Socket Mode)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-...
SLACK_STATE_SECRET=change-me-to-a-random-string

# Comma-separated bot scopes requested on install. Kept here, not hardcoded in app.ts,
# so scopes can change without a code deploy.
SLACK_SCOPES=commands,chat:write,chat:write.public,channels:read,groups:read,users:read,im:write

PORT=3300

# Postgres. Same VPS instance as Ledger, separate database (see README).
DATABASE_URL=postgres://called:change-me@localhost:5432/called

# Paddle billing
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# Base URL this app is reachable at, used to build the OAuth install page and redirect links.
PUBLIC_BASE_URL=https://api.called.runciter.app
