{
  "display_information": {
    "name": "Calledit",
    "description": "Record, seal and settle predictions in Slack.",
    "background_color": "#0a0a0a"
  },
  "features": {
    "bot_user": {
      "display_name": "Calledit",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/calledit",
        "description": "Make a call, or manage one you've already made.",
        "usage_hint": "[mine | open | lock <id> | resolve <id> | join <id>]",
        "should_escape": false
      }
    ],
    "shortcuts": [
      {
        "name": "Make a prediction",
        "type": "message",
        "callback_id": "make_a_prediction",
        "description": "Turn this message into the question for a new call."
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://api.called.runciter.app/slack/oauth_redirect"
    ],
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "chat:write.public",
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history",
        "users:read",
        "im:write",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true
    },
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups"
      ]
    },
    "org_deploy_enabled": false
  }
}
